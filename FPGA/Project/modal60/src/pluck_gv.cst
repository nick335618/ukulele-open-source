// ============================================================================
// pluck_gv.cst  —— 上位机串口控制顶层（top_gv_host）引脚约束
// 器件：GW5A-LV25MG121N（GW5A-25A，Sipeed Tang Primer 25K 核心板 + Dock）
//
//   clk(E2)        -> 板载 50MHz
//   rx(A1)         -> Dock 40P 槽 GPIO_A1/IOB24A  <- USB-TTL 模块 TXD
//   tx(E3)         -> Dock 40P 槽 GPIO_E3/IOB60A  -> USB-TTL 模块 RXD
//   i2s_bclk(F5)   -> CJMCU-5102 BCK
//   i2s_lrck(G7)   -> CJMCU-5102 LRCK
//   i2s_data(H8)   -> CJMCU-5102 DIN
//
// 引脚依据（Dock 60033 原理图 40P 引出 + GW5A-25 引脚手册）：
//   40P 槽带出的普通 GPIO 球号：A1 B2 C2 D1 E1 E3 F1 F2 G4 H1 H2 H4
//   （对应网络名 XX_IOBxx_40P）。其中：
//     A1 = IOB24A，special=none（普通 3.3V GPIO，已核对）   —— 作 FPGA rx
//     E3 = IOB60A，special=none（普通 3.3V GPIO，已核对）   —— 作 FPGA tx
//   B2/C2 = IOB4A/4B，也复用配置 I2C。当前 GPRJ/TCL 已启用 use_i2c_as_gpio，
//   用作触摸译码 EN#/LED片选；对应 Dock J3-14/J3-13。
//
// 接线：USB-TTL TXD -> A1(40P)，RXD <- E3(40P)，GND 共地；波特率 115200 8N1。
// 注意：rx 空闲为高，输入用 PULL_MODE=UP 防浮空；tx 为输出 DRIVE=8。
//   A1/E3 属不同 BGA Bank，Dock 为 3.3V-only，仍请在 40P 壳体上核对所选排针。
//   LP5860 LED 阵列：SPI SCK/MOSI/MISO 复用 tp_sck/tp_mosi/tp_miso，
//   新触摸电容.pdf：#CS0=C2/J3-13；EN#=B2/J3-14；LP5860 VSYNC接地。
//   其余 SW/CS 线直接接 LP5860，不经过 FPGA。
// ============================================================================

// ---- 主时钟 ----
IO_LOC  "clk"           E2;
IO_PORT "clk"           IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// ---- ★ v45：老 UART 命令链路（对比版用）----
//   只有把 top_gv_host 的 parameter USE_UART_CMD 改成 1 时才真正使用；
//   USE_UART_CMD=0（默认，触摸识别版）时 rx 空置、tx 恒 1，这两脚可以不接线。
//   rx = A1 = IOB24A = Dock J3-17（40P 槽），接 USB-TTL 的 TXD
//   tx = E3 = IOB60A = Dock J3-20（40P 槽），接 USB-TTL 的 RXD
//   115200 8N1；rx 空闲为高，用 PULL_MODE=UP 防浮空。
IO_LOC  "rx"            A1;
IO_PORT "rx"            IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "tx"            E3;
IO_PORT "tx"            IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- ★ v44/v52：触摸板 AD7147（I²C 版）—— 默认（USE_UART_CMD=0）走这条 ----
//   C2/B2 复用配置 I2C，未启用 use_i2c_as_gpio 时会报 dedicated pin。
//   当前已启用该选项，这两脚用于 LED；旧 I2C 触摸通路仍保持原有 F6/F7。
//     改用普通 IO：SCL=F6（J3-37）、SDA=F7（J3-38）—— 与将来 SPI 款的 SCLK/MOSI 同脚位，换芯片时线不用再挪。
//   ⚠ 两根都必须外接 4.7k~10k 上拉到 3.3V（原来 4.7k 做在 ESP32 一侧，
//     移植后要么保留 ESP32 板接着，要么在 FPGA 侧补上），否则 I²C 读不回来。
//   ⚠ ESP32 必须停止驱动这条 I²C（两个主机会抢总线）。
//   ⚠★ v52 实测教训：**不要写 OPEN_DRAIN=ON**！
//     RTL 里已经用三态实现了开漏（`oe ? 1'bz : 1'b0`，网表 = TBUF(I=GND, OEN=oe)，
//     Gowin 原语 TBUF=bufif0 ⇒ OEN 低有效），再加 OPEN_DRAIN 属性会让引脚**恒被拉低**
//     （实测：空闲 SCL/SDA 都是 0 V，连外部 4.7k 都拉不起来）。
//     去掉该属性后同一份 RTL 就正常了（空闲 = 释放，靠上拉为高）。
IO_LOC  "tp_scl"        F6;
IO_PORT "tp_scl"        IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "tp_sda"        F7;
IO_PORT "tp_sda"        IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Final SPI touch PCB CN1, 2026-10-01. Separate from ESP32 and ADS7950 SPI.
IO_LOC "tp_sck" K2;
IO_PORT "tp_sck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "tp_mosi" K1;
IO_PORT "tp_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "tp_miso" L1;
IO_PORT "tp_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "tp_addr[0]" L2;
IO_PORT "tp_addr[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "tp_addr[1]" K4;
IO_PORT "tp_addr[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "tp_addr[2]" J4;
IO_PORT "tp_addr[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// Revised PCB: CN1-6 is LED SS; CN1-7 is decoder EN#, not VSYNC.
IO_LOC "led_cs_n" C2;
IO_PORT "led_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "tp_en_n" B2;
IO_PORT "tp_en_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---- I2S -> PCM5102A ----
IO_LOC  "i2s_bclk"      F5;
IO_PORT "i2s_bclk"      IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "i2s_lrck"      G7;
IO_PORT "i2s_lrck"      IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "i2s_data"      H8;
IO_PORT "i2s_data"      IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- ★★ MCLK → PCM5102A 模块的 SCL 脚（2026-09-23 补）----
//   这一根是"能不能出声"的开关，不是可选：
//     本工程 fS = 50MHz/1024 = 48828.125 Hz，**不是标准采样率**，
//     PCM5102A 内部三线 PLL 只认 48/44.1/96k 等精确值 ⇒ 不给主时钟就【完全无声】。
//   必须走四线模式：SCL 接 G5，由 FPGA 输出 12.5 MHz（= 256×fS）。
//   05_i2s_tone / 06_full_system / 13_audio_pintest 三个能出声的工程都用 G5，
//   唯独融合成本工程时漏了 —— 详见 docs/接线图_audio_ext音频验证.md L81 / L162。
IO_LOC  "i2s_sck"       G5;
IO_PORT "i2s_sck"       IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- ★ 调试状态总线（v52 起固定约束，接万用表即可当"状态灯"）----
//     dbg_status[0] = K8 = J3-35 : sensor_ok（两颗 AD7147 的 Device ID 都读到 0x147x）
//     dbg_status[1] = K9 = J3-33 : id_ok[0]（0x2C 那颗对上了）
//     dbg_status[2] = L9 = J3-34 : id_ok[1]（0x2E 那颗对上了）
//     dbg_status[3] = E1 = J3    : err_any（出现过 NACK ⇒ 从机没回话）
//   ★ 2026-09-23 把 dbg_status[3] 从 J8 挪到 E1：J8 要留给 ESP32 链路（esp_rx），
//     沿用 06 工程已有的接线免得重新接线。dbg_status 只是"拿万用表量电平"的
//     调试脚，换脚无功能影响（E1 同在 40P 槽 J3 上，仍是同一排针）。
IO_LOC  "dbg_status[0]" K8;
IO_PORT "dbg_status[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "dbg_status[1]" K9;
IO_PORT "dbg_status[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "dbg_status[2]" L9;
IO_PORT "dbg_status[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "dbg_status[3]" E1;
IO_PORT "dbg_status[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ============ ★ ESP32 链路：SPI（2026-09-23 改用）============
//   ★★ 2026-09-23 晚：**从 J5 挪到 J3（40P 排针）**，原因是实测到的串扰：
//     原来 ESP32 的 4 根和光电板的 4 根挤在同一个 J5 排针上，而且
//     `E11`(光电 SDI) 与 `E10`(ESP32 MOSI)、`A11`(光电 SDO) 与 `A10`(ESP32 MISO)
//     都是**上下相邻的孔**。ESP32 以 2MHz 不停跑 SPI，把 ADS7950 的 SDO 采样带偏了。
//   证据链：
//     ① 早先的"J5 八脚侦探"实验里，八个脚（连三态的）**全部报 65535** ⇒ J5 上串扰严重；
//     ② 同一块光电板，跑 `14_opto_tune`（它没有 ESP32）读数稳定在 1900~2130、抖动仅 ±2 码；
//        而跑 gv_host 时读数在 2000 与 200 之间乱跳 ⇒ 差异就是那 4 根 ESP32 线。
//   ⇒ 现在 ESP32 走 J3 上排第 11~14 个孔（J1/G4/H1/K7），与 J5 的光电板物理分开。
//   用户手上的孔位图（板子正面看）：
//     上排: K1 L2 J4 G2 L4 GND B2 F2 E1 E3 J1 G4 H1 K7 L7 L10 L9 J8 F7 J11
//     下排: K2 L1 K4 G1 L3 5V  C2 F1 A1 D1 J2 H4 H2 J7 L8 K10 K9 K8 F6 J10
//   ⚠ 帧协议不变（AA CMD LEN PAYLOAD... CRC），只换物理位置。
//   ⚠ spi_miso 是 FPGA 输出但主机空闲时可能不驱动，用 PULL_MODE=UP 防浮空；
//     spi_cs_n 空闲为高（无效），也上拉。
//   ★驱动能力不要写 DRIVE：这几根脚无论写 DRIVE=4 还是 8，PnR 都报
//     "CT1108 Illegal port attribute value specified 'DRIVE = N'"。
//     原因是 K11/L11/E10 这几根**本身就是输入脚**（对输入脚写 DRIVE 当然报错）。
//     这里干脆不写 DRIVE、用默认值 —— 最稳，也够用（SPI 只到 2 MHz）。
//   ⇒ 2026-09-23 晚：最终采用**同学给的引脚分配**（他按 bank 和器件引脚名选的，
//     比我最初随手挑的 J1/G4/H1/K7 好得多：两两成对、同在 BANK 7、J3 上连续 4 个孔）：
//         esp_sck   = J7  (IOT21B, J3 脚27)   ← ESP32 GPIO18 VSPICLK
//         esp_mosi  = K7  (IOT21A, J3 脚28)   ← ESP32 GPIO23 VSPID
//         esp_miso  = L8  (IOT19B, J3 脚29)   → ESP32 GPIO19 VSPIQ
//         esp_cs_n  = L7  (IOT19A, J3 脚30)   ← ESP32 GPIO5  VSPICS0（低有效）
//     J7/K7 是 IOT21 的 B/A 对，L8/L7 是 IOT19 的 B/A 对，全在 BANK 7 ⇒ 电平/驱动一致。
//   用户手上的孔位图（板子正面看，J3 = 最上面那个 2×20）：
//     上排: K1 L2 J4 G2 L4 GND B2 F2 E1 E3 J1 G4 H1 K7 L7 L10 L9 J8 F7 J11
//     下排: K2 L1 K4 G1 L3 5V  C2 F1 A1 D1 J2 H4 H2 J7 L8 K10 K9 K8 F6 J10
//     ⇒ 上排第14个 = K7，上排第15个 = L7，下排第14个 = J7，下排第15个 = L8
//       （也就是【第14、15两列的一个 2×2 方块】，接线非常好认）
//   ⚠ 帧协议不变（AA CMD LEN PAYLOAD... CRC），只换物理位置。
//   ⚠ spi_miso 是 FPGA 输出但主机空闲时可能不驱动，用 PULL_MODE=UP 防浮空；
//     spi_cs_n 空闲为高（无效），也上拉。
//   ★驱动能力不要写 DRIVE：之前 K11/L11/E10 无论写 4 还是 8 都报 CT1108 ——
//     真正原因是**那几根本身就是输入脚**（对输入脚写 DRIVE 当然报错），与 bank 无关。
//     这里同样不写 DRIVE、用默认值。
IO_LOC  "spi_sck"   J7;
IO_PORT "spi_sck"   IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "spi_cs_n"  L7;
IO_PORT "spi_cs_n"  IO_TYPE=LVCMOS33 PULL_MODE=UP   BANK_VCCIO=3.3;
IO_LOC  "spi_mosi"  K7;
IO_PORT "spi_mosi"  IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "spi_miso"  L8;
IO_PORT "spi_miso"  IO_TYPE=LVCMOS33 PULL_MODE=UP   BANK_VCCIO=3.3;

// ============ 光电拨弦板 ADS7950：2026-10-10 按用户要求换引脚 ============
//   adc_cs_n = L5  -> 光电板 CS#  （FPGA 输出，低有效）
//   adc_sclk = K5  -> 光电板 SCLK （FPGA 输出）
//   adc_sdi  = E11 -> 光电板 SDI  （FPGA 输出，MOSI）
//   adc_sdo  = A11 <- 光电板 SDO  （FPGA 输入，MISO）
// 停止使用旧 H4/G4/H2/H1 的 ADC 信号连接；供电和共地要求不因换引脚改变。
// SPI 驱动、3.125MHz 时钟、ADS7950 通道顺序及光电消抖逻辑均保持原样。
// 输出仍为 DRIVE=4/PULL_MODE=NONE，SDO 保留内部上拉；没有改变驱动算法。
// 此处占用这些脚的普通 IO 功能，不把 GCLK/PLL 复用能力用于外部时钟。
IO_LOC  "adc_sclk" K5;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "adc_cs_n" L5;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "adc_sdi" E11;
IO_PORT "adc_sdi" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "adc_sdo" A11;
IO_PORT "adc_sdo" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 运放静音控制：普通逻辑输出，配置完成后始终为高，不用于给板供电。
IO_LOC  "opamp_mute_high" H5;
IO_PORT "opamp_mute_high" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
