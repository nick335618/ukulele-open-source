<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark baseline theme for Ukulele Studio.

      Colors are the frozen design tokens owned by colors.xml (T1):
        bg_root = #070D18, accent = #36DAD4
      The light theme is applied at runtime by AppTheme.applyWindow(), so this resource
      deliberately keeps the dark system-bar icon flags (false). Do not add AppCompat or
      Material parents: the app depends on the platform API only.
    -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
